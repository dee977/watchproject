# =================================================================
# AURELIA HAUTE HORLOGERIE - ENVIRONMENT CONFIGURATION
# =================================================================

# Database connection (Default: SQLite for instant local execution)
# To use PostgreSQL/Supabase:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/aurelia_db?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret for Secure Cookie Authentication
JWT_SECRET="aurelia_luxury_super_secret_jwt_key_2026_horology_secure_token"

# Base Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Razorpay Payment Gateway Keys (Test / Production)
# Get keys from https://dashboard.razorpay.com/app/keys
# If left blank or test keys, built-in interactive simulator enables seamless local checkout testing
RAZORPAY_KEY_ID="rzp_test_aurelia_demo_key_id"
RAZORPAY_KEY_SECRET="rzp_test_aurelia_demo_secret_key"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhook_secret_key"

# Email Provider Configuration (SMTP / Resend)
# If left empty, emails are formatted and logged to server console
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="concierge@aureliawatches.com"
EMAIL_SERVER_PASSWORD="smtp_password_here"
EMAIL_FROM="AURELIA Concierge <concierge@aureliawatches.com>"

# Google Maps API (Optional for Address Autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Cloud Storage (Optional for S3 / Supabase Storage uploads)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# =================================================================
# Configurable Admin & Demo Accounts (Used by seed & provisioning)
# Change these values anytime to customize the primary administrator
# =================================================================
ADMIN_EMAIL="admin@aurelia.com"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NAME="Alexander Vance"

DEMO_CUSTOMER_EMAIL="vikram@royalhorology.com"
DEMO_CUSTOMER_PASSWORD="Collector@123"
DEMO_CUSTOMER_NAME="Vikramaditya Roy"

